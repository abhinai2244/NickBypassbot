# Copy this file to ".env" and fill in YOUR OWN bot token if you want to
# run the optional local Telegram bot frontend.
#
# This file stays on YOUR machine. It is never read by any remote service
# and NickBypassBot never sends it anywhere.
#
# Get a token from @BotFather in Telegram.

BOT_TOKEN=
BOT_NAME=NickBypassBot
